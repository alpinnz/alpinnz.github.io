{
  "name": "alpinnz.github.io",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "localization:generate": "node scripts/prepare-localizations.mjs && valfuse-localization generate",
    "localization:validate": "node scripts/prepare-localizations.mjs && valfuse-localization validate",
    "localization:check": "node scripts/check-localizations.mjs",
    "verify:export": "node scripts/verify-static-export.mjs",
    "test:e2e": "playwright test",
    "predeploy": "npm run localization:check && npm run lint && npm run typecheck && npm run build && npm run verify:export && npm run test:e2e",
    "deploy": "gh-pages -d out --nojekyll --silent",
    "predev": "npm run localization:generate",
    "dev": "next dev",
    "prebuild": "npm run localization:generate",
    "build": "next build",
    "prelint": "npm run localization:generate",
    "lint": "eslint .",
    "pretypecheck": "npm run localization:generate",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@valfuse-node/form": "^0.3.5",
    "@valfuse-node/localization": "^0.5.0",
    "@valfuse-node/react": "^0.4.0",
    "@valfuse-node/validation": "^0.1.0",
    "framer-motion": "^12.43.0",
    "next": "16.4.2",
    "pdfkit": "^0.20.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
